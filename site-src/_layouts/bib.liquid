---
---
{%- assign thumb = entry.preview -%}
{%- assign venue = entry.venue_label | default: entry.abbr | default: entry.journal | default: entry.booktitle -%}
{%- if entry.overview -%}
  {%- if entry.overview contains '/' -%}
    {%- assign overview_url = entry.overview -%}
  {%- else -%}
    {%- assign overview_url = entry.overview | prepend: '/assets/pdf/' -%}
  {%- endif -%}
{%- endif -%}
<div class="pub-row" id="{{ entry.key | escape }}">
  <div class="pub-preview">
    {% if venue %}
      <span class="pub-venue">{{ venue | escape }}</span>
    {% endif %}
    {% if thumb %}
      {%- assign image_url = thumb | prepend: '/assets/img/publication_preview/' | relative_url -%}
      <figure class="pub-figure">
        {% if entry.overview %}
          <a href="{{ overview_url | relative_url }}" aria-label="View the full-size overview for {{ entry.title | escape }}">
        {% elsif entry.preview_source %}
          <a href="{{ entry.preview_source | escape }}">
        {% endif %}
          <img class="preview rounded" src="{{ image_url }}" alt="{{ entry.preview_alt | default: entry.title | escape }}" width="{{ entry.preview_width }}" height="{{ entry.preview_height }}" loading="lazy" decoding="async">
        {% if entry.overview or entry.preview_source %}</a>{% endif %}
      </figure>
    {% endif %}
  </div>
  <div class="pub-info">
    <div class="title">{{ entry.title }}</div>
    <div class="author">
      {%- if entry.display_author -%}
        {{- entry.display_author -}}
      {%- else -%}
      {%- for author in entry.author_array -%}
        {% unless forloop.first %}{% if author.last == 'others' %}, {% elsif forloop.last and forloop.length > 2 %}, and {% elsif forloop.last %} and {% else %}, {% endif %}{% endunless %}
        {%- if author.last == 'others' -%}et al.
        {%- elsif site.scholar.last_name contains author.last and site.scholar.first_name contains author.first -%}
          <em>{{ author.first }} {{ author.last }}</em>
        {%- else -%}
          {{ author.first }} {{ author.last }}
        {%- endif -%}
      {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="periodical">
      {% if entry.review_status %}<em>{{ entry.review_status | escape }}</em>
      {% else %}
        <em>{% if entry.journal %}{{ entry.journal }}{% else %}{{ entry.booktitle }}{% endif %}{% if entry.volume %}, {{ entry.volume }}{% endif %}{% if entry.pages %}, {{ entry.pages | replace: '--', '–' }}{% endif %}{% if entry.year %}, {{ entry.year }}{% endif %}</em>
      {% endif %}
    </div>
    {% if entry.additional_info %}<div class="periodical"><strong>{{ entry.additional_info }}</strong></div>{% endif %}
    {% if entry.note %}<div class="periodical"><strong>{{ entry.note | escape }}</strong></div>{% endif %}
    <div class="links">
      {% if entry.summary %}<button type="button" class="btn btn-sm z-depth-0" aria-expanded="false" aria-controls="summary-{{ entry.key }}">summary</button>{% endif %}
      {% if entry.abstract %}<button type="button" class="btn btn-sm z-depth-0" aria-label="Abstract" aria-expanded="false" aria-controls="abstract-{{ entry.key }}">abs</button>{% endif %}
      {% if entry.html %}<a href="{{ entry.html | escape }}" class="btn btn-sm z-depth-0">paper</a>{% elsif entry.pdf %}<a href="{{ entry.pdf | relative_url }}" class="btn btn-sm z-depth-0">paper</a>{% endif %}
      {% if entry.overview %}<a href="{{ overview_url | relative_url }}" class="btn btn-sm z-depth-0">Overview (PDF)</a>{% endif %}
    </div>
    {% if entry.summary %}<div class="pub-panel" id="summary-{{ entry.key }}" hidden><p>{{ entry.summary }}</p></div>{% endif %}
    {% if entry.abstract %}
      <div class="pub-panel" id="abstract-{{ entry.key }}" hidden>
        <p><strong>Abstract</strong></p><p>{{ entry.abstract | replace: '\%', '%' }}</p>
        {% if entry.abstract_source %}<p><a href="{{ entry.abstract_source | escape }}">Abstract source</a></p>{% endif %}
      </div>
    {% endif %}
  </div>
</div>
